# Repository whose live Supabase deployment can be tested. Static scanning
# works against any public GitHub repository; live validation is restricted
# to this one configured repository only.
DEMO_GITHUB_REPOSITORY=HW006-J/rls-red-alert-demo-target

# Optional server-only token to increase GitHub API rate limits.
# Public scanning works without it.
GITHUB_TOKEN=

# Isolated demonstration Supabase project used only for live validation of
# DEMO_GITHUB_REPOSITORY. Server-only — never exposed to the browser.
DEMO_SUPABASE_URL=
DEMO_SUPABASE_ANON_KEY=

# Pre-seeded test identities used to prove the live cross-tenant leak.
# Trainer A (attacker) authenticates and is shown to receive Trainer B's rows.
DEMO_ATTACKER_EMAIL=
DEMO_ATTACKER_PASSWORD=
DEMO_VICTIM_EMAIL=
DEMO_VICTIM_PASSWORD=

# Optional direct Postgres connection to the demo project. Not required by
# any current tooling — scripts/setup-demo-environment.mjs and the
# apply/reset repair endpoints perform all elevated schema/policy changes
# through the authenticated Supabase CLI (`supabase db query --linked`)
# instead of a raw database password. Leave blank unless you need direct
# psql access for manual debugging.
#
# The apply/reset repair endpoints require the Supabase CLI to be installed,
# authenticated, and linked (`supabase link`) on the machine running this
# app — true for this local hackathon demo, not a hosted deployment.
SUPABASE_DATABASE_URL=

# Optional absolute path to the Supabase CLI executable. Set this if the
# process running `next dev`/`next start` does not inherit the PATH your
# interactive shell uses (common for editor/task-runner-launched dev
# servers on macOS, where Homebrew's /opt/homebrew/bin is only added by a
# shell profile). If unset, common install locations are checked first,
# then bare `supabase` is tried via the inherited PATH as a last resort.
SUPABASE_CLI_PATH=

# Optional. When set, policies the deterministic rules can't classify are
# sent one at a time (capped per scan) to a real Gemini model for a semantic
# opinion, and confirmed critical findings on the demo repository can get an
# AI-proposed repair — both clearly labelled in the UI as AI output, not a
# guarantee. Everything else (scanning, live validation, applying the
# trusted repair, resetting the demo) works fully without it; AI-only steps
# are simply reported as not performed.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest (a Google-maintained alias that
# tracks the current recommended flash model) if unset — verified live.
GEMINI_MODEL=gemini-flash-latest

# Optional model provider
OPENAI_API_KEY=
